# ─────────────────────────────────────────────────────────────
# Cloak — root environment example. Copy to .env and adjust.
# apps/server also reads these (see apps/server/.env.example).
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# --- Identity / domain restriction ---
# Comma-separated list of allowed email domains. Only these may authenticate.
ALLOWED_EMAIL_DOMAINS=snapdeal.com
# Set to "true" in local dev to also allow example.com for testing.
ALLOW_TEST_DOMAIN=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://cloak:cloak@localhost:5432/cloak?schema=public

# --- Redis (cache, presence, socket.io adapter, rate limits) ---
REDIS_URL=redis://localhost:6379

# --- Auth / tokens ---
# CHANGE THESE in any non-local environment.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_SEC=900            # 15 minutes
REFRESH_TOKEN_TTL_SEC=2592000       # 30 days
REFRESH_COOKIE_NAME=cloak_rt

# --- Email verification (OTP) ---
OTP_LENGTH=6
OTP_TTL_SEC=600                     # 10 minutes
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
# In development, print the OTP to the server log so you can log in without SMTP.
OTP_DEV_LOG=true

# --- Email transport ---
# dev: uses Mailhog SMTP (docker). prod: swap to SES/SMTP creds.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cloak <no-reply@snapdeal.com>"

# --- Anonymous identity generation ---
IDENTITY_REGEN_COOLDOWN_SEC=3600    # 1 hour between regenerations
IDENTITY_REGEN_MAX_PER_DAY=5

# --- Rate limiting ---
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=10

# --- Object storage (media, later phases) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cloak-media
S3_ACCESS_KEY=cloak
S3_SECRET_KEY=cloak-secret
S3_FORCE_PATH_STYLE=true
