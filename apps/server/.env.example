# apps/server/.env.example — copy to apps/server/.env
NODE_ENV=development
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Domain restriction: only these email domains may authenticate.
ALLOWED_EMAIL_DOMAINS=snapdeal.com
ALLOW_TEST_DOMAIN=true

# Comma-separated emails granted the ADMIN role on login (bootstrap moderators
# in a fresh database — there are no seeded users). e.g. you@snapdeal.com
ADMIN_EMAILS=

# Database + Redis. REDIS_URL is OPTIONAL — set it only to scale across multiple
# API instances (Socket.IO adapter + shared presence). Leave empty for single node.
DATABASE_URL=postgresql://cloak:cloak@localhost:5432/cloak?schema=public
REDIS_URL=redis://localhost:6379

# LiveKit SFU (voice/video rooms). Dev keys match docker-compose's --dev mode.
#
# PRODUCTION / cross-device / ngrok: a browser served over HTTPS can only open a
# secure wss:// socket, and localhost is not reachable from other devices. Use
# LiveKit Cloud (free tier at https://cloud.livekit.io) or a TLS-terminated
# self-hosted server, then set:
#   LIVEKIT_URL=wss://<your-project>.livekit.cloud
#   LIVEKIT_API_KEY=<from LiveKit Cloud>
#   LIVEKIT_API_SECRET=<from LiveKit Cloud>
# In production the API refuses ws:// URLs and the dev devkey/secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Tokens (CHANGE in non-local envs)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
REFRESH_COOKIE_NAME=cloak_rt

# OTP / email verification
OTP_LENGTH=6
OTP_TTL_SEC=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
OTP_DEV_LOG=true

# ── Email delivery ──────────────────────────────────────────────────────────
# Transport selects how sign-in codes are delivered:
#   console → logs only, nothing is sent          (unit tests / quick local dev)
#   smtp    → any real SMTP relay                  (Mailhog in dev; SES/Workspace in prod)
#   resend  → Resend HTTPS API (RECOMMENDED prod)  (resilient to blocked SMTP ports)
#
# Local dev with Mailhog (view mail at http://localhost:8025):
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
#
# Real delivery via Resend (sign up at resend.com, create an API key):
#   EMAIL_TRANSPORT=resend
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#   # While testing you can send from Resend's shared sender:
#   EMAIL_FROM=Cloak <onboarding@resend.dev>
#   # In production use your own verified domain, e.g. no-reply@snapdeal.com
RESEND_API_KEY=
EMAIL_FROM=Cloak <no-reply@snapdeal.com>
EMAIL_REPLY_TO=

# Anonymous identity generation rules
IDENTITY_REGEN_COOLDOWN_SEC=3600
IDENTITY_REGEN_MAX_PER_DAY=5

# Rate limiting
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=10


# ── Media storage ───────────────────────────────────────────────────────────
# Uploads are streamed back through the API with signed capability URLs.
#   local → disk under MEDIA_DIR (dev / single node; wiped on redeploy)
#   s3    → any S3-compatible store (Backblaze B2, Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER=local
MEDIA_DIR=.uploads
MEDIA_MAX_BYTES=26214400
#
# Backblaze B2 (S3-compatible). In the B2 console: create a bucket + an
# Application Key; the key's "keyID" is the access key and "applicationKey" is
# the secret. Endpoint + region come from the bucket's "Endpoint" (e.g.
# s3.us-east-005.backblazeb2.com → region us-east-005):
#   STORAGE_DRIVER=s3
#   S3_ENDPOINT=https://s3.<region>.backblazeb2.com
#   S3_REGION=<region>            # e.g. us-east-005
#   S3_ACCESS_KEY_ID=<B2 keyID>
#   S3_SECRET_ACCESS_KEY=<B2 applicationKey>
#   S3_BUCKET=<your bucket name>
# (Cloudflare R2 instead? S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false
